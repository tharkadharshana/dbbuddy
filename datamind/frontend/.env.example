# ─────────────────────────────────────────────────────────────────────────────
# DataMind AI — Frontend Environment Configuration
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.
#
# Vite only exposes variables prefixed with VITE_ to the browser bundle.
# ─────────────────────────────────────────────────────────────────────────────


# ─── App Name ─────────────────────────────────────────────────────────────────
# The display name shown in page titles, headings, and UI text.
VITE_APP_NAME=SalesPlay AI


# ─── API Base URL (Embed Widget Only) ─────────────────────────────────────────
# The full URL of your DataMind backend API.
# Used by the embed widget (src/embed/embedApi.js) so the iframe can reach
# the API when embedded inside a partner's domain (e.g. Salesplay).
#
# Local development: leave blank — the Vite dev server proxy forwards
#   all /api/* requests to http://localhost:8000 automatically.
#
# Production: set to your deployed backend URL.
#   Example: VITE_API_URL=https://api.datamind.ai
#
# The main app (non-embed pages) never reads this variable — it always
# uses the /api proxy which Vite (dev) or your web server (prod) handles.
VITE_API_URL=

# ─── Main App URL (Embed Widget Only) ─────────────────────────────────────────
# The full URL of the standalone DataMind web app. Used by the embed widget's
# "Open in DataMind" link so users can leave the partner's iframe and manage
# their account, billing, and full analytics in the full DataMind experience.
#   Example: VITE_APP_URL=https://app.datamind.ai
VITE_APP_URL=

# ─── Salesplay AI POS Subscription Polling (Embed Widget Only) ────────────────
# After a payment succeeds, activation isn't instant on Salesplay's side —
# confirmed on predev2 that activation_status doesn't flip right after a
# successful charge. The plans screen polls subscription/info instead of
# checking once. Same pattern for card-add: the user adds their card on
# Salesplay's own page in another tab, so we poll for it instead of making
# them manually refresh the widget.
#
#   VITE_SALESPLAY_ACTIVATION_POLL_ATTEMPTS    — how many times to poll after payment (default 6)
#   VITE_SALESPLAY_ACTIVATION_POLL_INTERVAL_MS — delay between activation polls, ms (default 3000)
#   VITE_SALESPLAY_CARD_POLL_INTERVAL_MS       — delay between card-add polls, ms (default 3000)
VITE_SALESPLAY_ACTIVATION_POLL_ATTEMPTS=6
VITE_SALESPLAY_ACTIVATION_POLL_INTERVAL_MS=3000
VITE_SALESPLAY_CARD_POLL_INTERVAL_MS=3000
