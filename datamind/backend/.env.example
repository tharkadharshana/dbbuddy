# ─── JWT Auth ────────────────────────────────────────────────────────────────
# REQUIRED: Change to a long random string before deploying
SECRET_KEY=datamind-change-this-secret-in-production-2024

# ─── Logging ─────────────────────────────────────────────────────────────────
# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR  (default: INFO)
# LOG_FORMAT: pretty (human-readable coloured) | json (machine-readable, one line per event)
# LOG_FILE:   optional file path, e.g. logs/datamind.log (leave blank for stdout only)
LOG_LEVEL=INFO
LOG_FORMAT=pretty
LOG_FILE=

# ─── Fallback Database (Optional) ────────────────────────────────────────────
# Used ONLY if a user has no DB configured in Settings → Database Connections.
# Leave blank — users should add their own DB via the UI.
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# ─── Fallback LLM API Keys (Optional) ────────────────────────────────────────
# Used ONLY if a user has not entered their own key in Settings → LLM API Keys.
# Leave blank — users should add their own keys via the onboarding wizard.
# Get Gemini key:   https://aistudio.google.com/app/apikey
# Get DeepSeek key: https://platform.deepseek.com/api_keys
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# ─── DataMind Internal Database (for External API integrations) ──────────────
# If you want to use external API integrations (Loyverse, Square, etc.)
# DataMind needs its OWN MySQL database to store synced data.
# This can be the same DB as DB_* above, or a separate one.
# Leave blank to fall back to DB_* values.
DATAMIND_DB_HOST=
DATAMIND_DB_PORT=3306
DATAMIND_DB_NAME=datamind_internal
DATAMIND_DB_USER=
DATAMIND_DB_PASSWORD=

# ─── Encryption Key (for credential storage) ─────────────────────────────────
# Used to encrypt API tokens/credentials stored for integrations.
# If not set, falls back to SECRET_KEY. Set this to a separate value in prod.
ENCRYPTION_KEY=


SALESPLAY_BASE_URL=https://spdeveloperapi.nvision.lk/v1.0