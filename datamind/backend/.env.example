# ─── JWT Auth ────────────────────────────────────────────────────────────────
# Change this to a long random string in production!
SECRET_KEY=datamind-change-this-secret-in-production-2024

# ─── Default Database (Fallback) ─────────────────────────────────────────────
# Used only if a user has no DB configured in Settings.
# You can leave these blank if all users will add their own DB via the UI.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=root
DB_PASSWORD=

# ─── Default LLM API Keys (Fallback) ─────────────────────────────────────────
# Used only if a user has not entered their own keys in Settings.
# Users can always override these with their own keys via Settings → API Keys.
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
