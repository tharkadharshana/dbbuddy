# ─────────────────────────────────────────────────────────────────────────────
# DataMind AI — Backend Environment Configuration
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real secrets.
# ─────────────────────────────────────────────────────────────────────────────


# ─── App Name ─────────────────────────────────────────────────────────────────
# The display name used in API docs, logs, and email templates.
APP_NAME=SalesPlay AI


# ─── JWT Auth ─────────────────────────────────────────────────────────────────
# REQUIRED. Generate a strong random key before deploying:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=datamind-change-this-secret-in-production


# ─── Credential Encryption ────────────────────────────────────────────────────
# Used to encrypt Salesplay / Loyverse API tokens stored in user_integrations.
# Falls back to SECRET_KEY if not set. Use a separate value in production.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
ENCRYPTION_KEY=


# ─── DataMind Internal Database ───────────────────────────────────────────────
# The MySQL database DataMind uses for its own data:
#   users, user_integrations, sync_logs, billing tables, embed_partners
# This can be the same MySQL instance as a user's own DB, or a dedicated one.
DATAMIND_DB_HOST=localhost
DATAMIND_DB_PORT=3306
DATAMIND_DB_NAME=datamind_db
DATAMIND_DB_USER=datamind_user
DATAMIND_DB_PASSWORD=your_db_password_here


# ─── User Default Database (Optional Fallback) ────────────────────────────────
# Used ONLY if a user has no DB configured in Settings → Database Connections.
# Leave blank — users should add their own DB through the UI.
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# ─── Per-User External DB Pool ────────────────────────────────────────────────
# When users connect their own MySQL database, DataMind creates a small connection
# pool per unique DB config instead of opening raw connections on every request.
#
# USER_DB_POOL_SIZE: connections per unique user DB. 3 is sufficient for most
#   users (NL query + analytics rarely run in parallel for a single user).
#   Each pool holds USER_DB_POOL_SIZE persistent TCP connections.
#
# MAX_USER_DB_POOLS: cap on simultaneous user DB pools in this process.
#   At 3 connections each: 50 pools = 150 external connections.
#   Users beyond this cap get raw per-request connections (safe, just slower).
USER_DB_POOL_SIZE=3
MAX_USER_DB_POOLS=50


# ─── Server / Workers — CAPACITY PLANNING ─────────────────────────────────────
# UVICORN_WORKERS and DB_POOL_SIZE (below) are the two settings that determine
# how many users the main app AND the SalesPlay/Loyverse web embed can serve
# AT THE SAME TIME — both share this same backend process and DB pool via the
# /v1/query endpoint. Full derivation, formulas, and worked examples live in
# /docs/server-setup/CAPACITY_ANALYSIS.md — read that before changing these in
# production.
#
# THE BOTTLENECK: each /v1/query request holds one DB_POOL_SIZE connection for
# the ENTIRE duration of 1-2 external LLM API calls (SQL generation, plus a
# second "Think Mode" call which defaults ON for the main app and is forced ON
# for the embed) — not just the SQL execution itself. So the DB pool, not the
# CPU, is normally the limit.
#
#   Max simultaneous in-flight /query requests
#       = UVICORN_WORKERS × min(DB_POOL_SIZE, 40)
#         (40 = FastAPI/AnyIO's fixed per-worker threadpool size — raising
#          DB_POOL_SIZE above 40 gives no further benefit)
#
#   Concurrent ACTIVE chat users supported
#       ≈ (max in-flight requests) × 3 to 7   (mid-estimate ×5 — accounts for
#         "think time" between a user's messages; see docs/server-setup/CAPACITY_ANALYSIS.md §7)
#
# QUICK SIZING TABLE (mid-estimate ×5; MySQL max_connections must be raised to
# match — see DB_POOL_SIZE below):
#   ──────────────────────────────────────────────────────────────────────────
#   Target concurrent     UVICORN_WORKERS   DB_POOL_SIZE   MySQL max_connections
#   active users          (× DB_POOL_SIZE)  (per worker)   needed (W×P + 20)
#   ──────────────────────────────────────────────────────────────────────────
#         100                  1                20                40   (defaults below)
#         500                 10                10               120
#       1,000                 20                10               220
#       2,500                 25                20               520   (managed DB)
#   ──────────────────────────────────────────────────────────────────────────
#
# UVICORN_WORKERS: Python processes to spawn. Each gets its own DB pool AND its
#   own copy of pandas/prophet/sklearn in memory (~0.5GB/worker — budget RAM
#   accordingly: WORKERS ≤ (RAM_GB - 2) / 0.5).
#   Dev:  1  (single process, --reload works, simplest for debugging)
#   Prod: CPU cores × 2 + 1  (e.g. 4-core → 9, 8-core → 17), capped by the RAM
#         rule above and by DB_POOL_SIZE × WORKERS staying under max_connections.
#   WARNING: UVICORN_WORKERS × DB_POOL_SIZE must be < MySQL max_connections - 20.
#
# UVICORN_HOST: 127.0.0.1 for dev (localhost only), 0.0.0.0 for prod (public).
# UVICORN_PORT: TCP port to bind. 8000 is the default.
#
# Start with: python start.py          (dev, 1 worker, auto-reload)
#             python start.py --prod   (prod, UVICORN_WORKERS workers, no reload)
UVICORN_WORKERS=1
UVICORN_HOST=127.0.0.1
UVICORN_PORT=8000


# ─── MySQL Connection Pool ────────────────────────────────────────────────────
# Number of pooled MySQL connections per server process (uvicorn worker), shared
# by ALL embed users and all main-app users on a SalesPlay/Loyverse integration
# (own-DB main-app users get a separate small pool — see USER_DB_POOL_SIZE above).
#
# Formula: UVICORN_WORKERS × DB_POOL_SIZE < MySQL max_connections - 20 (headroom)
# DB_POOL_SIZE above 40 has no effect — the per-worker threadpool (40 threads)
# becomes the limit first. See "CAPACITY PLANNING" comment above for the full
# sizing table and /docs/server-setup/CAPACITY_ANALYSIS.md for derivation.
#
# Safe sizing examples:
#   Dev  (1 worker,  pool 20) →  20 connections  — fine with max_connections=151 (MySQL 8 default)
#   Prod (4 workers, pool 10) →  40 connections  — safe with max_connections=200
#   Prod (8 workers, pool 10) →  80 connections  — needs max_connections≥120
#   Prod (10 workers, pool 10)→ 100 connections  — needs max_connections≥120
#
# Before going to production, confirm your actual limit with:
#   SHOW VARIABLES LIKE 'max_connections';
# Raise MySQL limit first (in my.cnf): max_connections = 500
# Then raise UVICORN_WORKERS and/or DB_POOL_SIZE to match.
DB_POOL_SIZE=20

# DB_POOL_BORROW_TIMEOUT: seconds to wait for a pool connection before failing.
#   Without a timeout, all request threads block forever when the pool is exhausted
#   and the server appears completely frozen. With this set, overloaded requests
#   get an immediate error instead of piling up. Range: 2-30. Default: 5.
DB_POOL_BORROW_TIMEOUT=5


# ─── Performance Tuning ───────────────────────────────────────────────────────
# SQL_TIMEOUT_MS: hard time limit (milliseconds) on every user-facing SQL query.
#   Kills runaway LLM-generated queries (Cartesian products, missing WHERE clause)
#   before they exhaust the connection pool. 30000 = 30 seconds.
SQL_TIMEOUT_MS=30000

# MAX_CONCURRENT_SYNCS: cap on background sync threads running simultaneously.
#   Each sync borrows 3 pool connections. Rule: MAX_CONCURRENT_SYNCS × 3 < DB_POOL_SIZE.
#   Syncs beyond this cap are skipped and retried by the scheduler on the next 60s tick.
MAX_CONCURRENT_SYNCS=5

# SUB_CACHE_TTL: seconds to cache a user's subscription/billing state per process.
#   Each compute request (NL query, analytics, forecast) checks billing via 5+ DB
#   queries. This cache reduces that to 1 query on the first request, then 0 for
#   the TTL window. Cache is busted immediately on plan changes.
#   Acceptable lag: if a user hits their token limit, they can continue for at
#   most SUB_CACHE_TTL seconds before being blocked. Range: 30-300. Default: 60.
SUB_CACHE_TTL=60

# ANALYTICS_CACHE_TTL: seconds to cache Analytics Hub query results.
#   Each template click runs a SQL query. With caching the 2nd click on the same
#   template returns instantly with no DB hit. Busted after each sync completes.
#   Range: 60-600. Default: 300 (5 minutes).
ANALYTICS_CACHE_TTL=300

# INTEGRATION_CACHE_TTL: seconds to cache each user's integration metadata row.
#   get_integration() runs on every compute request. Cache eliminates repeated
#   DB lookups for table_prefix, provider_id, and sync status.
#   Busted on connect, disconnect, or sync completion.
#   Range: 60-600. Default: 300 (5 minutes).
INTEGRATION_CACHE_TTL=300

# MODEL_CACHE_TTL: seconds to cache Prophet / IsolationForest training results.
#   Forecast and anomaly requests re-train ML models fresh per call (2-10s each).
#   With caching, the same input data returns instantly. Cache key is a hash of
#   the input rows, so new data after a sync automatically bypasses the cache.
#   Range: 300-3600. Default: 600 (10 minutes).
MODEL_CACHE_TTL=600


# ─── Conversation Memory ──────────────────────────────────────────────────────
# CONV_HISTORY_WINDOW: number of recent messages included in the LLM context
#   on each query. Higher values give the LLM more context for follow-up
#   questions but increase token usage. Range: 5-50. Default: 20.
CONV_HISTORY_WINDOW=20

# CONV_SUMMARY_THRESHOLD: auto-summarise the conversation after this many
#   messages. Older messages are condensed into a 2-3 sentence summary so the
#   prompt stays bounded even in very long conversations. Default: 20.
CONV_SUMMARY_THRESHOLD=20

# CONV_POST_SUMMARY_TAIL: number of recent message pairs (user + assistant)
#   kept verbatim after summarisation. These follow the summary in the prompt
#   so the LLM has exact recent context. Default: 5.
CONV_POST_SUMMARY_TAIL=5


# ─── LLM API Keys (Server-Level Fallback) ─────────────────────────────────────
# Used when a user has not entered their own LLM key in Settings.
# Also used automatically for embed (Salesplay iframe) users, since they
# go through a compact onboarding wizard that does not include key setup.
#
# KEY POOL: Each value can be a single key OR a comma-separated list of keys.
# The backend tries them in order. When one key hits a rate limit (429) it is
# parked for 60 seconds and the next key is tried automatically. A key that
# returns 401/403 (invalid/expired) is parked for 1 hour. This lets you spread
# load across multiple accounts or recover automatically when one key runs out.
#
# Examples:
#   Single key:  OPENAI_API_KEY=sk-abc123
#   Key pool:    OPENAI_API_KEY=sk-key1,sk-key2,sk-key3
#
# Get OpenAI key:   https://platform.openai.com/api-keys
# Get Gemini key:   https://aistudio.google.com/app/apikey
# Get DeepSeek key: https://platform.deepseek.com/api_keys
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=


# ─── LLM Behaviour ────────────────────────────────────────────────────────────
# Order in which LLMs are tried when a user's preferred LLM key is missing.
# Comma-separated. First provider with a valid key wins; if a provider has a
# key but the call fails at runtime, the next one in this order is tried.
LLM_PRIORITY=openai,gemini,deepseek


# ─── QA dev routes (/qa/*) — NEVER SET THESE IN PRODUCTION ────────────────────
# Mounts a development-only harness that MUTATES BILLING STATE: change plan,
# expire a subscription, drain/reset tokens, clear or age the report cache.
# Used to exercise the doc 14 §B2 plan matrix without waiting for real periods.
#
# Three independent locks, ALL of which must pass before the router mounts:
#   1. QA_ROUTES_ENABLED=true
#   2. no production signal — refuses if FORCE_HTTPS=true, or if
#      DATAMIND_DB_HOST looks production-like (contains prod / rds.amazonaws /
#      cloudsql / salesplaypos.com)
#   3. QA_ROUTES_EMAILS is non-empty AND contains the calling account
#      (there is deliberately no "allow everyone" mode)
#
# When any check fails the routes are never registered, so /qa/* 404s exactly
# as if the module did not exist. All three are re-checked on every request,
# so access can be revoked without restarting.
#
# Drive it with:  python qa_report_cache.py     (from the repo root)
# Or the dev-only UI at /qa (Vite strips that page from production builds).
QA_ROUTES_ENABLED=false
QA_ROUTES_EMAILS=


# ─── AI_FLOW — how a question gets answered ───────────────────────────────────
# See docs/16_Pure_Agent_Architecture.md. THE one switch that decides the
# answering architecture. Everything in the two sections below it is implied.
#
#   legacy  (default) — today's pipeline: safety gate -> follow-up rewriter ->
#             classifier -> 8-way branch tree -> MCP tool loop -> the model's
#             own answer DISCARDED and regenerated by a narrator that never saw
#             the question. Reads MCP_* and the conversational-layer flags below.
#
#   agent   — the plain agent: the question goes to the model untouched with the
#             tools attached, and the model's own text IS the answer. No
#             classifier, no rewriter, no narrator, no Think Mode. The model
#             decides whether it needs the merchant's data, its own knowledge,
#             or both — and whether a table or chart helps (it writes a markdown
#             table, or a ```chart block, inside its own answer).
#             Guards kept: AST SQL safety + tenant scoping, the plan history
#             window (clamped, not refused), plan feature entitlement (enforced
#             by not registering the tool), and the harm-refusal safety gate.
#
# AI_FLOW_TEST_EMAILS: comma-separated allowlist for a staged rollout of `agent`.
#   Blank = every user gets it once AI_FLOW=agent. Legacy users are unaffected.
#
# WHEN AI_FLOW=agent, ALSO SET:
#   MCP_MAX_TOOL_ITERATIONS=8   — the agent plans multi-step investigations; at
#                                 5 a compare-two-periods question runs out of
#                                 turns before it can answer.
#   REPORT_CACHE_ENABLED=true   — without it the agent gets NO report tools, no
#                                 forecast and no anomaly detection, and falls
#                                 back to raw SQL whose numbers do not match the
#                                 merchant's POS dashboard.
AI_FLOW=legacy
AI_FLOW_TEST_EMAILS=

# AGENT_MAX_ATTEMPTS: retries of the whole agent loop (fresh API key each time)
#   before returning an honest transient error. It never falls through to a
#   different, weaker answering path — answering the same question with two
#   different architectures depending on whether a rate limit landed is what
#   made answers non-deterministic in the first place. Default 2.
AGENT_MAX_ATTEMPTS=2


# ─── MCP Tool-Calling (Business-Data MCP server) ──────────────────────────────
# Used by AI_FLOW=legacy. Lets the model call get_schema/get_sample_rows/
# run_select_query/get_date_range tools and self-correct before answering,
# instead of one blind SQL guess. Off by default; falls back to the legacy
# one-shot query path on any failure.
# See docs/04_MCP_Architecture_And_Implementation_Guide.md.
#
# MCP_TOOL_CALLING_ENABLED: master on/off switch. Ignored when AI_FLOW=agent
#   (the agent branch returns before this is read).
# MCP_TOOL_CALLING_TEST_EMAILS: comma-separated allowlist for staged rollout.
#   Leave blank to enable for ALL users once MCP_TOOL_CALLING_ENABLED=true.
#   Set to specific accounts (e.g. your own) to try it before a wider rollout.
# MCP_MAX_TOOL_ITERATIONS: safety cap on how many tool-calling round-trips one
#   question may take. Shared by BOTH flows — legacy gives up and falls back to
#   the one-shot path, the agent retries then errors honestly.
#   legacy: 5 is fine.  agent: use 8.
MCP_TOOL_CALLING_ENABLED=false
MCP_TOOL_CALLING_TEST_EMAILS=
MCP_MAX_TOOL_ITERATIONS=5

# ─── Smart Answers (answer-quality rollout) ───────────────────────────────────
# AI_FLOW=legacy ONLY — ignored entirely when AI_FLOW=agent.
# When true, the assistant answers like an analyst grounded in the merchant's
# own data: the classifier gains an out_of_scope guardrail (coding/off-topic get
# a cheap deflection), routes advice/forecast questions to a real data-grounded
# answer instead of refusing, defaults vague periods, and the answer layer is
# allowed to reason, advise, and use markdown. Off = legacy narrow behaviour.
SMART_ANSWERS_ENABLED=false

# ─── Conversational-layer fixes (PLAN_09 / PLAN_10, benchmark-driven) ──────────
# AI_FLOW=legacy ONLY. When AI_FLOW=agent these are all bypassed: there is no
# classifier to guard, no rewriter to run (the model resolves its own follow-ups
# against real message history), and the sanitiser is forced ON regardless
# because the model's own text is the product with nothing else in the way.
#
# All default OFF — OFF reproduces today's behaviour exactly. Roll out one at a
# time and re-run benchmark/ between changes (never flip two in one run).
#
# FOLLOWUP_REWRITE_ENABLED    — a cheap pre-classification LLM call rewrites bare
#                               follow-ups ("for this week", "then fried rice?")
#                               into a standalone question using recent turns, so
#                               the classifier/tools/answer all see a complete
#                               question. Fixes short follow-ups losing the thread.
# ANSWER_SANITISER_ENABLED    — exit filter that strips internal identifiers
#                               (sp_/ly_ table names, SQL, tool names, report
#                               slugs) from every outgoing answer.
# BUSINESS_KNOWLEDGE_ENABLED  — narrow route: answer retail/business definitions
#                               and how-to questions instead of refusing them.
#                               SUPERSEDED by ANSWER_EVERYTHING_ENABLED — do not
#                               enable both.
# ANSWER_EVERYTHING_ENABLED   — scope→safety inversion (recommended): answer
#                               general knowledge, strategy and advice by default,
#                               grounded in the merchant's data where relevant.
#                               Refuses only for genuine harm, politely declines
#                               coding/SQL help. (The harm-refusal + advice-caveat
#                               safety gate is ALWAYS on and needs no flag.)
FOLLOWUP_REWRITE_ENABLED=false
ANSWER_SANITISER_ENABLED=false
BUSINESS_KNOWLEDGE_ENABLED=false
ANSWER_EVERYTHING_ENABLED=false


# ─── External Provider API Base URLs ──────────────────────────────────────────
# Override only when pointing to a staging or mock API during development.
# Production default: https://api.salesplaypos.com/v1.0
#SALESPLAY_BASE_URL=https://spdeveloperapi.nvision.lk/v1.0
SALESPLAY_BASE_URL=https://spqaapi.nvision.lk/v1.0


# ─── Salesplay Sync Behaviour ─────────────────────────────────────────────────
# Controls how the Salesplay background sync fetches and retries data.
#
#   SALESPLAY_PAGE_SIZE            — items per paginated API call (default 250, max 250)
#   SALESPLAY_RATE_SLEEP           — seconds between paginated requests (default 1.1)
#   SALESPLAY_DEFAULT_LOOKBACK_DAYS— delta sync window in days when no last-sync found (default 90)
#   SALESPLAY_HTTP_TIMEOUT         — per-request HTTP timeout in seconds (default 30)
#   SALESPLAY_RETRY_ATTEMPTS       — retries on connection/timeout failures (default 3)
#   SALESPLAY_VERIFY_SSL           — set to false only for dev environments with cert issues;
#                                    MUST be true in production (default false for dev)
SALESPLAY_PAGE_SIZE=250
SALESPLAY_RATE_SLEEP=1.1
SALESPLAY_DEFAULT_LOOKBACK_DAYS=90
SALESPLAY_HTTP_TIMEOUT=30
SALESPLAY_RETRY_ATTEMPTS=3
SALESPLAY_VERIFY_SSL=false


# ─── Salesplay Embed Proxy ────────────────────────────────────────────────────
# Server-side proxy settings for the Salesplay public app API.
# The iframe cannot call Salesplay directly (CORS), so we proxy via our backend.
#
#   SALESPLAY_EMBED_PROXY_BASE    — Salesplay public app base URL
#                                   (production: https://api.salesplaypos.com/v2.0/public/app)
#   SALESPLAY_EMBED_PROXY_TIMEOUT — proxy request timeout in seconds (default 10)
#   SALESPLAY_EMBED_RATE_LIMIT    — max /embed/init calls per IP per window (default 5)
#   SALESPLAY_EMBED_RATE_WINDOW   — rate limit rolling window in seconds (default 60)

#QA
#SALESPLAY_EMBED_PROXY_BASE=https://spqa.nvision.lk/rest/v2.0/public/app
 
#PROD
#SALESPLAY_EMBED_PROXY_BASE=https://cloud.salesplaypos.com/rest/v2.0/public/app

SALESPLAY_EMBED_PROXY_BASE=https://api.salesplaypos.com/v2.0/public/app
SALESPLAY_EMBED_PROXY_TIMEOUT=10
SALESPLAY_EMBED_RATE_LIMIT=5
SALESPLAY_EMBED_RATE_WINDOW=60

# ─── Report cache (SalesPlay /app/* report + profile APIs) ────────────────────
# REPORT_CACHE_ENABLED       — master flag: sync tenant profile (shops/cashiers/
#                              currency) + stash the live session token at every
#                              widget onboarding (default false)
# REPORT_API_HTTP_TIMEOUT    — report endpoints run up to 90s server-side
# REPORT_API_RETRY_ATTEMPTS  — retries for 429/5xx responses
REPORT_CACHE_ENABLED=false
REPORT_API_HTTP_TIMEOUT=90
REPORT_API_RETRY_ATTEMPTS=3

# SALESPLAY_SHARED_SECRET — pre-shared AES-256-GCM key for the X-Filter-Key
#   header SalesPlay's internal report API requires on date-ranged calls.
#   See docs/salesplay-encrypted-param.md. Get the value from the SalesPlay
#   team; never commit it. Leave blank ONLY for local/predev testing —
#   report_cache/filter_key.py falls back to a placeholder key and logs a
#   loud warning every time it does. Must be set for real before this runs
#   anywhere else.
SALESPLAY_SHARED_SECRET=
# REPORT_API_MAX_PAGE_CAP            — max pages fetched per report/month
# REPORT_CACHE_MIN_CALL_INTERVAL     — seconds between report-API calls (backfill rate limit)
#
# REPORT_CACHE_BACKFILL_MONTHS_CAP   — OPS SAFETY VALVE. LEAVE UNSET/0.
#   Backfill depth belongs to plan_history_limits, not to a constant. This used
#   to default to 24, which silently truncated every paid plan: Pro's window is
#   200 months, so a month-40 question passed the entitlement check, found
#   nothing cached, and fell through to a live report fetch on EVERY ask,
#   forever. Set a number only to throttle a runaway backfill in an incident.
#
# REPORT_CACHE_REFINALIZE_MONTHS     — trailing closed months re-fetched on every
#   backfill run, to catch late refunds/voids that mutate an already-closed
#   month. Default 2.
#
# REPORT_CACHE_DEEP_REFINALIZE_DAYS  — any cached month whose figures are older
#   than this is re-fetched too, however far back it sits in the plan window.
#   Without it, a refund posted in July against an APRIL receipt is never picked
#   up: April's cached total stays permanently too high and permanently
#   disagrees with what the merchant sees in SalesPlay. Derived from
#   report_sync_state.fetched_at, so it needs no extra state and self-heals.
#   Default 7. Set 0 to disable.
REPORT_API_MAX_PAGE_CAP=50
REPORT_CACHE_MIN_CALL_INTERVAL=1.0
REPORT_CACHE_BACKFILL_MONTHS_CAP=
REPORT_CACHE_REFINALIZE_MONTHS=2
REPORT_CACHE_DEEP_REFINALIZE_DAYS=7

# ─── SSE streaming (POST /v1/query/stream) ────────────────────────────────────
# Streams step/thinking/token/data/done events for chat. When false the
# endpoint 404s and clients fall back to plain POST /v1/query.
SSE_STREAMING_ENABLED=false


# ─── Embed Partner Integration ────────────────────────────────────────────────
# Global CORS + CSP gate for all /embed/* endpoints.
# When set, only these origins can make requests to the embed API.
#
# In production set this to your partner domain(s):
#   EMBED_ALLOWED_ORIGINS=https://app.salesplay.io,https://backoffice.salesplay.io
# Leave blank locally (dev defaults to localhost origins only).
EMBED_ALLOWED_ORIGINS=

# Per-partner iframe origins — used by scripts/seed_embed_partners.py to populate
# the embed_partners DB table.  These control postMessage validation inside the iframe.
# Set to the exact domain(s) your partner uses to host the DataMind iframe.
SALESPLAY_EMBED_ORIGINS=https://app.salesplay.io,https://backoffice.salesplay.io
LOYVERSE_EMBED_ORIGINS=https://r.loyverse.com,https://loyverse.com


# ─── Rate Limiting ────────────────────────────────────────────────────────────
# Format: "<count>/<period>"  e.g. "10/minute", "200/hour"
# Restart the server after changing these values.
#
# USER endpoints (main app) — bucketed PER IP ADDRESS (= per end-user).
#   "10/minute" means each individual user can make 10 calls/minute.
#   It is NOT a global cap across all users.
#
#   AUTH         — POST /auth/register           (brute-force protection)
#   AUTH_LOGIN   — POST /auth/login              (brute-force protection)
#   COMPUTE      — /query, /analytics/run, /forecast*, /anomalies*, /report,
#                  /integrations/*/analytics/run, /integrations/*/forecast
#                  (LLM + ML endpoints — expensive per call, tighten in prod)
#   READ         — all GET endpoints             (cheap reads, raise freely)
#   WRITE        — onboarding, settings/db, providers/connect|validate|sync,
#                  billing/subscribe|addon|config, cache/rebuild, auth/account
#
RATE_LIMIT_AUTH=5/minute
RATE_LIMIT_AUTH_LOGIN=10/minute
RATE_LIMIT_COMPUTE=10/minute
RATE_LIMIT_READ=60/minute
RATE_LIMIT_WRITE=30/minute
#
# PARTNER API endpoints (/v1/partner/*) — bucketed PER X-API-KEY (= per partner).
#   "30/minute" means each partner key gets 30 calls/minute across ALL
#   of their users combined. A partner serving 1000 users shares this bucket.
#   Raise this generously for active partners; they control their own traffic.
#
#   V1           — all /v1/partner/* endpoints
#
RATE_LIMIT_V1=30/minute


# ─── Logging ──────────────────────────────────────────────────────────────────
# LOG_LEVEL:  DEBUG | INFO | WARNING | ERROR
#             DEBUG logs every request + DB query detail. Use INFO in production.
# LOG_FORMAT: pretty  — coloured, human-readable (good for local dev)
#             json    — one JSON object per line, great for grep/jq/log aggregators
# LOG_FILE:   file path to write logs to in addition to stdout.
#             Directory is created automatically if it doesn't exist.
#             Every log line includes "user" and "tenant_id" fields, so you can
#             filter per-user easily:
#               grep '"user":"alice@example.com"' logs/datamind.log | jq .
#               jq 'select(.tenant_id == "dm_abc_salesplay")' logs/datamind.log
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=logs/datamind.log
