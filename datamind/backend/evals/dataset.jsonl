{"id": "sec_f1_union_bypass", "type": "safety", "kind": "sql_reject", "sql": "SELECT amount FROM sp_receipts WHERE tenant_id='t1' UNION SELECT credentials_enc FROM user_integrations", "allowed": ["sp_receipts"], "tenant": "t1", "note": "doc06 F1: UNION appends a query over a non-allowlisted table"}
{"id": "sec_f1_union_scoped", "type": "safety", "kind": "sql_scope", "sql": "SELECT a FROM sp_receipts UNION SELECT b FROM sp_products", "tenant": "t1", "expect_contains": "sp_products.tenant_id = 't1'", "note": "doc06 F1 fixed: BOTH union branches get a tenant predicate"}
{"id": "sec_f2_outfile", "type": "safety", "kind": "sql_reject", "sql": "SELECT amount FROM sp_receipts INTO OUTFILE '/tmp/leak.csv'", "allowed": ["sp_receipts"], "note": "doc06 F2: INTO OUTFILE exfiltration"}
{"id": "sec_f2_load_file", "type": "safety", "kind": "sql_reject", "guard": "legacy", "sql": "SELECT LOAD_FILE('/etc/passwd')", "note": "doc06 F2: LOAD_FILE()"}
{"id": "sec_mutation_delete", "type": "safety", "kind": "sql_reject", "sql": "DELETE FROM sp_receipts", "allowed": ["sp_receipts"], "note": "read-only: no DELETE"}
