{"id": "sec_tenant_scope_subquery", "type": "safety", "kind": "sql_scope", "sql": "SELECT * FROM (SELECT a FROM sp_receipts) t", "tenant": "acme", "expect_contains": "sp_receipts.tenant_id = 'acme'", "note": "subquery scope scoped"}
