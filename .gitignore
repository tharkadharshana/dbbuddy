# Node.js
node_modules/
dist/
dist-ssr/
*.local

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
env/
.env
.env.local
.env.production
.env.front.dev
.env.front.prod
.env.front.beta

# Frontend prod build config holds no secrets (app name + public URLs) and must be
# tracked so CI can build the production bundle without any repo secrets.
!datamind/frontend/.env.production

# IDEs
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Project specific
sql_analytics_ai_dashboard.html
datamind/backend/scratch/
datamind/backend/data/users.json
datamind/backend/data/cache/*
datamind/backend/logs/datamind.log
docs/*
# Runbooks are procedures for the live deployment, not build output:
# they are versioned with the code they operate on.
!docs/deployment/
docs/deployment/*
!docs/deployment/runbooks/
logs/
archives/
patches/
# Local debug / one-off scripts
check_history.py
check_messages.py
check_shop.py
healthcheck.py
reset_qa_usage.py

# QA runner config — holds live Salesplay aats. Never commit.
scripts/qa_*.local.json
scripts/.qa_instance_*.log

# Local DB backups/dumps (large, sensitive — never commit)
backups/
*.sql

# Local dev-server logs (uvicorn / vite), written at repo root
backend.log
backend.err.log
frontend.log
